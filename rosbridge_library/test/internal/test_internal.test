<launch>
  <!-- Test internal library components -->
  <test test-name="test_message_conversion" pkg="rosbridge_library" type="test_message_conversion.py" />
  <test test-name="test_outgoing_message" pkg="rosbridge_library" type="test_outgoing_message.py" />
  <test test-name="test_ros_loader" pkg="rosbridge_library" type="test_ros_loader.py" />
  <test test-name="test_cbor_conversion" pkg="rosbridge_library" type="test_cbor_conversion.py" />
  <test test-name="test_compression" pkg="rosbridge_library" type="test_compression.py" />

  <!-- Test action-related internal components -->
  <include file="$(find rosbridge_library)/test/internal/actions/test_actions.test" />

  <!-- Test publisher manager components -->
  <test test-name="test_multi_publisher" pkg="rosbridge_library" type="test_multi_publisher.py" />
  <test test-name="test_publisher_manager" pkg="rosbridge_library" type="test_publisher_manager.py" />

  <!-- Test service components -->
  <include file="$(find rosbridge_library)/test/internal/services/test_services.test" />

  <!-- Test subscriber manager components -->
  <test test-name="test_multi_subscriber" pkg="rosbridge_library" type="test_multi_subscriber.py" />
  <test test-name="test_subscriber_manager" pkg="rosbridge_library" type="test_subscriber_manager.py" />
  <test test-name="test_subscription_modifiers" pkg="rosbridge_library" type="test_subscription_modifiers.py" />
</launch>
