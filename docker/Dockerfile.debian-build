# Dockerfile for building Debian packages of rosbridge_suite with BSON support
FROM ros:humble

# Install packaging tools and dependencies
RUN apt-get update && apt-get install -y \
    python3-bloom \
    python3-rosdep \
    fakeroot \
    debhelper \
    dh-python \
    dpkg-dev \
    build-essential \
    python3-pip \
    python3-setuptools \
    python3-colcon-common-extensions \
    git \
    libxml2-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install \
    bson \
    pymongo \
    cbor2 \
    twisted \
    tornado \
    autobahn

# Fix setuptools compatibility
RUN pip3 install --force-reinstall "setuptools==70.0.0" "packaging==21.3"

# Set working directory
WORKDIR /workspace

# Create output directory for built packages
RUN mkdir -p /output

# Copy the build script
COPY docker/build-single-deb.sh /workspace/

# Make the build script executable
RUN chmod +x /workspace/build-single-deb.sh

# Default command - use single package build
CMD ["/workspace/build-single-deb.sh"]
